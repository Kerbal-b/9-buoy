#!/bin/sh /etc/rc.common
# OpenWrt procd service for the receive-only buoy dashboard.

USE_PROCD=1
START=95
STOP=10

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/python3 /root/mavlink-bridge/mavlink_bridge.py
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
